{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "_comment": "Phase 5.5 — three build profiles. `development` produces a dev-client APK that includes Expo Go-equivalent runtime PLUS native AR modules (when added in Phase 6). `preview` is for QA on real devices. `production` is the store build.",
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.160.24.195:4000",
        "EXPO_PUBLIC_API_KEY": "dev-local-key-change-me"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://painterapp-staging.example.com",
        "EXPO_PUBLIC_API_KEY": ""
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://painterapp.example.com",
        "EXPO_PUBLIC_API_KEY": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
