# --- server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins. Use * for any (dev only).
CORS_ORIGINS=*

# --- security ---
# At least one API key is required. Comma-separate to support multiple clients.
API_KEYS=dev-local-key-change-me

# Max upload size in megabytes
MAX_UPLOAD_MB=15

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# --- storage ---
# Folders are created at startup if missing
UPLOAD_DIR=./uploads
DATA_DIR=./data

# --- measurement gates (Phase 1 GPS + Phase 3 polygon) ---
# GPS hard-refusal threshold in metres. Captures with worse accuracy are
# refused by /measure with HTTP 422 when PAINTERAPP_GPS_STRICT=true.
PAINTERAPP_GPS_MAX_ACCURACY_M=15
# Set to false ONLY for indoor development — production must be true.
PAINTERAPP_GPS_STRICT=true

# Polygon validation gates (cm-space)
PAINTERAPP_POLYGON_ASPECT_MAX=200
PAINTERAPP_POLYGON_MC_SAMPLES=5000
PAINTERAPP_POLYGON_MC_TOLERANCE=0.01

# --- bind (advanced; default 0.0.0.0) ---
# PAINTERAPP_HOST=0.0.0.0
